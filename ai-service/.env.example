# Copy this file to `.env` and fill in your key. The .env file is git-ignored.
OPENAI_API_KEY=sk-your-key-here

# Models (override only if you know why). gpt-4o-mini tier: cheap + fast.
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
EXTRACT_MODEL=gpt-4o-mini

# Comma-separated list of browser origins allowed to call this service.
# Vite dev server defaults to 5173.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Reject uploads larger than this (bytes). Default 15 MB.
MAX_AUDIO_BYTES=15728640
